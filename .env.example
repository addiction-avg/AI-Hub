PORT=3000
HOST=0.0.0.0
COMPOSE_PROJECT_NAME=ai-relay

DATABASE_URL=postgresql://ai_relay:ai_relay_password@localhost:5432/ai_relay
REDIS_URL=redis://localhost:6379
APP_SECRET=replace-with-a-long-random-local-secret

# 管理后台 Key 只用于 /admin/* 接口，和中转站用户 Key 分开。
# 支持 role:key 格式；role 可选 owner/admin/viewer。裸 Key 默认 owner。
ADMIN_API_KEYS=admin-local-dev

# 多个用户 Key 用英文逗号分隔。MVP 会把它们当作可用的中转站访问 Key。
RELAY_API_KEYS=sk-local-dev

# 上游模型供应商。先按 OpenAI 兼容格式接入，后面可扩展到 Anthropic/Gemini 专用适配器。
OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
OPENAI_COMPAT_API_KEY=replace-with-provider-key

# 模型路由：左边是对外暴露模型名，右边是真实供应商模型名。
MODEL_ALIASES=gpt-4o-mini:gpt-4o-mini,deepseek-chat:deepseek-chat

# Redis 限流。
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# MVP 初始余额，单位先用“请求点数”。后续接 token 计费。
INITIAL_CREDITS=1000
