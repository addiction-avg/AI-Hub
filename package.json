{
  "name": "ai-relay-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/admin"
  ],
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:api": "tsx watch src/server.ts",
    "dev:admin": "npm run dev --workspace apps/admin",
    "dev:db": "docker compose up -d postgres redis",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "build:api": "tsc -p tsconfig.json",
    "build:admin": "npm run build --workspace apps/admin",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:import-state": "tsx scripts/import-state.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "ioredis": "^5.11.0",
    "nanoid": "^5.1.0",
    "pg": "^8.21.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pg": "^8.20.0",
    "prisma": "^7.8.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
